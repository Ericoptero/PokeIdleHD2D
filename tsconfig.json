{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable", "webworker"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "tools/**/*.js", "tests/**/*.js", "studio/**/*.js", "types/**/*.d.ts", "*.config.js"],
  "exclude": ["node_modules", "dist", "public"]
}
